                                            <a class="dropdown-item" data-ajax="true" data-ajax-confirm="¿Está seguro que desea regresar la evaluación? Tenga en cuenta los tiempos por favor" data-ajax-mode="replace" data-ajax-update="#Principal" href="/Gestion/CambiarStatus/@item.Evaluacion.id?status=5">Cambiar evaluación de jefe</a>
                                            <h6 class="dropdown-header">Evaluación de fin año</h6>
                                            <a class="dropdown-item" data-ajax="true" data-ajax-confirm="¿Está seguro que desea regresar la evaluación? Tenga en cuenta los tiempos por favor" data-ajax-mode="replace" data-ajax-update="#Principal" href="/Gestion/CambiarStatus/@item.Evaluacion.id?status=10">Cambiar inicio de evaluación</a>
                                            <a class="dropdown-item" data-ajax="true" data-ajax-confirm="¿Está seguro que desea regresar la evaluación? Tenga en cuenta los tiempos por favor" data-ajax-mode="replace" data-ajax-update="#Principal" href="/Gestion/CambiarStatus/@item.Evaluacion.id?status=11">Cambiar evaluación de jefe</a>
                                        </div>
                                    </div>
                                }
                            </td>
                            <td>
                                @if (item.Evaluacion != null)
                                {
