        function AbreCierraDilogoEspera() {
            //var isOpen = $("#DivWaitPrincipal").dialog("isOpen");
            if ($('#myModal').hasClass('show')) {
                //alert('Abierto');
                $('#myModal').modal('hide');
                document.getElementById('myModal').style.pointerEvents = 'auto';
            }
            else {
                //alert('Cerrado');
                document.getElementById('myModal').style.pointerEvents = 'none';
                $('#myModal').modal('show');
            }
        }
    </script>

</head>
<body>
    <div class="container">
        <div class="row" style="border-bottom: 1px solid red">
            <div class="col-3"> <br /><img src="~/Imgs/ASPEN2.png" style="width:180px" /></div>
            <div class="col-9" style="text-align:right;margin-top:30px;"><h2> @*<b style="color:red"> Capacitación </b>*@ @*OJO comentar en Producción*@  Sistema de Evaluación de Desempeño</h2><span style="font-size: 1.8em;">@ViewBag.Titulo</span> </div>
            <hr />
        </div>
        <div class="row">
            <div class="col-md-12 "><b>@ViewBag.NomUsr</b></div>
        </div>
        <br />

        <p style="align-content:flex-end">

        </p>
        <div class="row">
            <div class="col-md-3">
                @Html.Partial("_Menu")
            </div>
            <div class="col-md-9">
                @RenderBody()
            </div>
</div>
            <div style="width:100%">

            </div>
    </div><!-- /.container -->
    @*background-color:#004b8d;*@
    <footer class="col-md-12 foot-style" style="background-color:#004b8d;margin-top: 25px;">
        <div style="display:inline-block">
            <p style="color:white">Sistema de Evaluación de Desempeño | @ViewBag.Titulo </p>
            <p style="color:white"> &copy; <b>@DateTime.Now.Year Powered by Aspen Labs | development IT area | ver 3.0</b> &nbsp;&nbsp; </p>
        </div>
        <div style="display:inline">
            <img src="~/Imgs/LogoB.png" style="width: 7%; height:8%; " />
        </div>
    </footer>


    <div class="modal" id='myModal'>
        <div class="modal-header">
            @*<button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>*@
            <h3 id="myModalLabel" style="color:white">Cargando:</h3>
        </div>
        <div class="modal-body" style="text-align:center">
            @*<img src="~/Imgs/carga.gif" style="width:25%; height:25%;" alt="Imagen de espera." />*@
            <img src="~/Imgs/Aspen-gif.gif" style="width:20%; height:20%;" alt="Imagen de espera." />
        </div>
    </div>


