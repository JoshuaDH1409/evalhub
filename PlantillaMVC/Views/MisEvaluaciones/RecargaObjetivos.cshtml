<style>
    #accordion div {
        border: 1px solid #d6d6d6;
    }
</style>



<div id="accordion">
    @if (Model != null)
    {
        foreach (Modelo.EObjetives item in Model)
        {
            <h3 class="Objetivos" style="position:relative;">
                @item.titulo
                <div style="position: absolute; top: 0px;right: 4px; border: 0;">
                    @if (ViewBag.status == 0 || ViewBag.status == 2 || (ViewBag.status == 4 && ViewBag.usuario == 0 && item.Etapa != 5) || (ViewBag.status == 5 && ViewBag.usuario == 1) || (ViewBag.status == 6 && ViewBag.usuario == 1) || (ViewBag.status == 10 && ViewBag.usuario == 0 && item.Etapa != 10) || (ViewBag.status == 11 && ViewBag.usuario == 1) || (ViewBag.status == 12 && ViewBag.usuario == 1) || (ViewBag.status == 16 && ViewBag.usuario == 0))
                    {
                        @Ajax.ActionLink(" ", "OperacionObjetivos", "MisEvaluaciones", new { id = item.id, eval = item.Eval, status = ViewBag.status, Usr = ViewBag.usuario, tot = ViewBag.PesoTotal }, new AjaxOptions { UpdateTargetId = "Detalle", OnBegin = "AbreCierraDilogoEspera", OnComplete = "AbreCierraDilogoEspera", OnSuccess = "AbrirDetalle" }, new { @class = "fa fa-edit", style = "color: #FFF;", @title = "Editar" })
                        @Ajax.ActionLink(" ", "EliminaUnObjetivos", "MisEvaluaciones", new { id = item.id }, new AjaxOptions { UpdateTargetId = "", OnBegin = "AbreCierraDilogoEspera", OnComplete = "AbreCierraDilogoEspera();VerificaSesionEnv()", OnSuccess = "loadTable()", Confirm = "¿Seguro desea eliminar el elemento?" }, new { @class = "fa fa-times", @style = "color: red;", @title = "Eliminar" })
                    }
                </div>
            </h3>
            <div style="padding: 10px;">
                <table class="table table-sm table-bordered table-striped">
                    <thead><tr></tr></thead>
                    <tbody>
                        <tr>
                            <th width="25%">Descripción</th>
                            <td colspan="2">@item.objdesc</td>
                        </tr>
                        <tr>
                            <th>Métrica (KPI)</th>
                            <td colspan="2">@item.objMetricas</td>
                        </tr>
                        <tr>
                            <th>Peso ponderado %</th>
                            <td colspan="2">@item.ponderado</td>
                        </tr>
                        @if (ViewBag.status >= 4 && ViewBag.status < 16)
                        {
                            <tr>
                                <td colspan="3" style="background-color: #337AB7; color: #FFF; font-weight: bold;">Evaluación de Medio año</td>
                            </tr>
                            <tr>
                                <th></th>
                                <th>Comentarios</th>
                                @*<th>Cumplimiento %</th>*@
                            </tr>
                            <tr>
                                <th>Evaluado</th>
                                <td class="AutoEvalCell">@item.resultado</td>
                                @*<td>@item.cumplimientoEvaluado</td>*@
                            </tr>
                            <tr>
                                <th scope="row">Evaluador</th>
                                <td class="JefeEvalCell">@item.ComentariosJefeEval</td>
                                @*<td>@item.cumplimientoEvaluador</td>*@
                            </tr>
                            if (ViewBag.status >= 10 && ViewBag.status < 16)
                            {
                                <tr>
                                    <td colspan="3" style="background-color: #337AB7; color: #FFF; font-weight: bold;">Evaluación de Fin de año</td>
                                </tr>
                                <tr>
                                    <th></th>
                                    <th>Comentarios</th>
                                    <th>Cumplimiento</th>
                                </tr>
                                <tr>
                                    <th>
                                        Evaluado
                                    </th>
                                    <td class="AutoEvalCell2">@item.Resultado2</td>
                                    <td>@item.cumplimientoEvaluado2</td>
                                </tr>
                                <tr>
                                    <th>Evaluador</th>
                                    <td class="JefeEvalCell2">@item.ComentariosJefeEval2</td>
                                    <td>@item.cumplimientoEvaluador2 ->@item.ValorObj</td>
                                </tr>
                                @*<tr>
                                        <th>Comentario Final</th>
                                        <td>@item.ComentariosJefeEvalFinall2</td>
                                        <td></td>
                                    </tr>*@
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</div>
        @if (ViewBag.status < 11 || ViewBag.Status>15)
        {
<div class="clearfix alert alert-dark mt-1">
    <div class="float-left"><strong>Total peso objetivos (%)</strong></div>
    <div class="float-right"><strong id="pesototalobjetivos">@ViewBag.PesoTotal</strong></div>
</div>
        }
        else
        {
<div class="clearfix alert alert-success mt-1">
    <div class="float-left"><strong>Calificación: @Model.Sum(m => m.ValorObj)</strong></div>
    @*<div class="float-right"><strong id="">Calificación: @ViewBag.CalFinalTemp </strong></div>*@
</div>
        }

<script>
    $(function () {
        $("#accordion").accordion({
            active: false,
            collapsible: true,
            heightStyle: "content"
        });
        var pesototal = '@ViewBag.PesoTotal';
        var nobjetivos = '@ViewBag.nObjetivos';
        //alert(nobjetivos);
        //CAMBIO_OBJETIVOS: SE ACEPTARAN 10 OBJETIVOS
        if (parseInt(nobjetivos) >= 10) {
            $("#btnNuevoObjetivo").hide();
        }
        else {
            $("#btnNuevoObjetivo").show();
        }
        $("#txtPesoTotal").val(pesototal);
        $("#pesototalobjetivos").html(pesototal);
    });
</script>