<div id="TblCompetencias">
    <div id="accordionComp" class="">
        @if (Model != null)
        {
            foreach (Modelo.ECompetemces item in Model)
            {
                <h3 class="Competencias" style="position: relative;">
                    @item.tituloTemp
                    <div style="position: absolute; top: 0px;right: 4px; border: 0;">
                        @if (ViewBag.status == 0 || ViewBag.status == 2 || (ViewBag.status == 4 && ViewBag.usuario == 0 && item.Etapa != 5) || (ViewBag.status == 5 && ViewBag.usuario == 1) || (ViewBag.status == 6 && ViewBag.usuario == 1) || (ViewBag.status == 10 && ViewBag.usuario == 0 && item.Etapa != 10) || (ViewBag.status == 11 && ViewBag.usuario == 1) || (ViewBag.status == 12 && ViewBag.usuario == 1) || (ViewBag.status == 16 && ViewBag.usuario == 0))
                        {
                            @Ajax.ActionLink(" ", "OperacionCompetencias", "MisEvaluaciones", new { id = item.id, eval = ViewBag.Eval, status = ViewBag.status, Usr = ViewBag.usuario }, new AjaxOptions { UpdateTargetId = "DetalleCompetencias", OnBegin = "AbreCierraDilogoEspera", OnComplete = "AbreCierraDilogoEspera();VerificaSesionEnv()", OnSuccess = "AbrirCompetencias()" }, new { @class = "fa fa-edit", @style = "color: #FFF;", @title = "Editar" })
                            if(ViewBag.status == 0 || ViewBag.status == 2 || ViewBag.status == 5 && (item.Etapa == 5 || item.Etapa == 2) || ViewBag.status == 11 && (item.Etapa == 10 || item.Etapa == 7) || (ViewBag.status == 16 && ViewBag.usuario == 0))
                            {
                                @Ajax.ActionLink(" ", "EliminaUnaCompetencia", "MisEvaluaciones", new { id = item.id }, new AjaxOptions { UpdateTargetId = "", OnBegin = "AbreCierraDilogoEspera();VerificaSesionEnv()", OnComplete = "AbreCierraDilogoEspera();VerificaSesionEnv()", OnSuccess = "loadCompetences", Confirm = "¿Seguro desea eliminar el elemento?" }, new { @class = "fa fa-times", @style = "color: red; ", @title = "Eliminar" })
                            }
                            if((ViewBag.status == 4 && item.Etapa != 5) || (ViewBag.status == 10 && item.Etapa != 10))
                            {
                                @Ajax.ActionLink(" ", "EliminarCompetenciasUsr", "MisEvaluaciones", new { id = item.id, Stat = ViewBag.status }, new AjaxOptions { UpdateTargetId = "", OnBegin = "AbreCierraDilogoEspera", OnComplete = "AbreCierraDilogoEspera();VerificaSesionEnv()", OnSuccess = "loadCompetences", Confirm = "¿Seguro desea eliminar el elemento?" }, new { @class = "fa fa-times", @style = "color: red; ", @title = "Eliminar" })
                            }
                        }
                    </div>
                </h3>
                <div style="padding: 10px;">
                    <table class="table table-sm table-bordered table-striped">
                        <tr class="Competencias">
                            <td style="background-color: #F9F9F9; font-weight: bold;">Actividades</td>
                            <td>@item.actividades</td>
                        </tr>
                        @if (ViewBag.status >= 4 && ViewBag.status < 16)
                        {
                            <tr>
                                <td colspan="2" style="background-color: #337AB7; color: #FFF; font-weight: bold;">Evaluación de Medio año</td>
                            </tr>
                            <tr>
                                <td>Comentario evaluado</td>
                                <td class="ResultadoComp">@item.resultados</td>
                            </tr>
                            <tr>
                                <td>Comentario evaluador</td>
                                <td class="ResultadoCompEval">@item.resultadosEvaluador</td>
                            </tr>
                            if (ViewBag.status >= 10 && ViewBag.status < 16)
                            {
                                <tr>
                                    <td colspan="2" style="background-color: #337AB7; color: #FFF; font-weight: bold;">Evaluación fin de año</td>
                                </tr>
                                <tr>
                                    <td>Comentario evaluado</td>
                                    <td class="ResultadoComp2">@item.resultados2</td>
                                </tr>
                                <tr>
                                    <td>Comentario evaluador</td>
                                    <td class="ResultadoComp2Eval">@item.resultados2Evaluador</td>
                                </tr>
                            }
                        }
                    </table>
                </div>
            }
        }
    </div>
</div>
<script>
        $(function () {
            $("#accordionComp").accordion({
                collapsible: true,
                active: false,
                heightStyle: "content"
            });
        });
</script>