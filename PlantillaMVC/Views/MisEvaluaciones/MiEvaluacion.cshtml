                                        </tr>
                                        <tr>
                                            <th>
                                                Evaluado
                                            </th>
                                            <td class="AutoEvalCell2">@item.Resultado2</td>
                                            <td>@item.cumplimientoEvaluado2</td>
                                        </tr>

                                        if (Model.sesion.Evaluacion.Status >= 11 && Model.sesion.Evaluacion.Status <= 12)
                                        {
