@{
    ViewBag.Title = "Inicio";
}

<div class="evalhub-login-card" style="max-width:720px">
    <div class="evalhub-login-hero">
        <img src="~/Imgs/evalhub-logo.png" alt="EvalHub" class="evalhub-login-logo" />
        <h2>EvalHub</h2>
        <p class="lead">Sistema de evaluaciones de desempeño, objetivos, periodos y reportes.</p>
    </div>
    <div class="row text-center">
        <div class="col-md-4">
            <h4>Evaluaciones</h4>
            <p>Flujos por etapas entre evaluado y evaluador.</p>
        </div>
        <div class="col-md-4">
            <h4>Objetivos</h4>
            <p>Definición, revisión, KPIs y resumen.</p>
        </div>
        <div class="col-md-4">
            <h4>Dashboard</h4>
            <p>Visibilidad por periodo, país y área.</p>
        </div>
    </div>
    <p class="text-center mt-3">
        <a class="btn btn-evalhub" href="@Url.Action("Login", "Account")">Iniciar sesión</a>
    </p>
</div>
