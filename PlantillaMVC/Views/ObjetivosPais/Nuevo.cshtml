@model Modelo.EObjetivoPais

@using (Ajax.BeginForm("Guardar", "ObjetivosPais", new { }, new AjaxOptions
{
    UpdateTargetId = "Principal",
    OnBegin = "AbreCierraDilogoEspera",
    OnComplete = "AbreCierraDilogoEspera();VerificaSesionEnv();CerrarPantalla()",
    HttpMethod = "Post"
}, new { id = "Usuario", novalidate = "novalidate" }))
{ 
    @Html.AntiForgeryToken()

<div class="form-horizontal">
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    @Html.HiddenFor(model => model.ID)
    @Html.HiddenFor(model => model.Periodo_Id)
    @Html.HiddenFor(model => model.Pais_Id)

    <div class="form-group">
        @Html.LabelFor(model => model.Objetivo_Dsc, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-12">
            @Html.EditorFor(model => model.Objetivo_Dsc, new { htmlAttributes = new { @class = "form-control", required = true } })
            @Html.ValidationMessageFor(model => model.Objetivo_Dsc, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.Objetivo_Peso, htmlAttributes: new { @class = "control-label col-md-4" })
        <div class="col-md-8">
            @Html.EditorFor(model => model.Objetivo_Peso, new { htmlAttributes = new { @class = "form-control", required = true, @type = "number", min = 1, max = 100 } })
            @Html.ValidationMessageFor(model => model.Objetivo_Peso, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.Objetivo_Cumplimiento, htmlAttributes: new { @class = "control-label col-md-4" })
        <div class="col-md-8">
            @Html.EditorFor(model => model.Objetivo_Cumplimiento, new { htmlAttributes = new { @class = "form-control", required = true, @type = "number", min = 0, max = 115 } })
            @Html.ValidationMessageFor(model => model.Objetivo_Cumplimiento, "", new { @class = "text-danger" })
        </div>
    </div>
    <hr />
    <div class="form-group">
        <div class="col-md-offset-8 col-md-4 float-right">
            <input type="submit" value="Guardar" class="btn btn-primary" />
        </div>
    </div>
</div>
}

<div style="visibility:hidden; display:none;">
    @Ajax.ActionLink("Verifica encabezados", "ValidaUsuario", "Usuario", new { },
            new AjaxOptions { UpdateTargetId = "", OnBegin = "AbreCierraDilogoEspera", OnComplete = "AbreCierraDilogoEspera", HttpMethod = "GET", OnSuccess = "RespuestaCurp(data, status, xhr)" },
    new { id = "ValidaUsuario" })
</div>
<script>
    $(document).ready(function () {
        var objeto = $(".oculto");
        objeto.hide();
        var pesototal = '@ViewBag.PesoTotal';
        var peso = $("#Objetivo_Peso").val();
        var form = $("#Usuario");
        $(form).removeData("validator");
        $(form).validate({
            submitHandler: function (form) {
                var peso = $("#Objetivo_Peso").val();
                var total = parseInt(pesototal) + parseInt(peso);
                if (total <= 100) {
                    form.ajaxSubmit();
                }
                else {
                    alert("La suma de los ponderados de objetivos debe ser igual a 100. Revise los ponderados y vuelva a intentarlo. La suma actual es " + total);
                }
            }
        });
        $.validator.unobtrusive.parse(form);
    });
</script>