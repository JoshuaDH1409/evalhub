@model List<Modelo.EPersonalTP>
<script>
    $(function () {
        $(".wmd-view-topscroll").scroll(function () {
            $(".wmd-view")
                .scrollLeft($(".wmd-view-topscroll").scrollLeft());
        });
        $(".wmd-view").scroll(function () {
            $(".wmd-view-topscroll")
                .scrollLeft($(".wmd-view").scrollLeft());
        });
    });

    $(function () {
        $(".wmd-view-topscroll2").scroll(function () {
            $(".wmd-view2")
                .scrollLeft($(".wmd-view-topscroll2").scrollLeft());
        });
        $(".wmd-view2").scroll(function () {
            $(".wmd-view-topscroll2")
                .scrollLeft($(".wmd-view2").scrollLeft());
        });
    });
</script>
<style>
    #accordion div {
        border: 1px solid #d6d6d6;
    }

    #accordionObjetivosPTP div {
        border: 1px solid #d6d6d6;
    }

    #accordionObjetivosPTP .ui-state-default {
        background: #337AB7;
        color: #FFF;
        border: 0;
        cursor: pointer;
    }

    #accordionObjetivosPTP .ui-state-active {
        background: #58ACFA;
        color: #FFF;
    }
</style>

<div id="accordionObjetivosPTP">
    @if (Model != null)
    {
        foreach (Modelo.EPersonalTP item in Model)
        {
            <h3 class="ObjetivosPTP" style="position: relative;">
                @item.ObjetivePTP
                <div style="position: absolute; top: 0px;right: 4px; border: 0;">
                    @*AQUÍ SE REALIZARIA UNA VALIDACIÓN EN CASO DE SER REQUERIDA*@
                    @*if (ViewBag.status == 0 || ViewBag.status == 2 || (ViewBag.status == 4 && ViewBag.usuario == 0 && item.Etapa != 5) || (ViewBag.status == 5 && ViewBag.usuario == 1) || (ViewBag.status == 6 && ViewBag.usuario == 1) || (ViewBag.status == 10 && ViewBag.usuario == 0 && item.Etapa != 10) || (ViewBag.status == 11 && ViewBag.usuario == 1) || (ViewBag.status == 12 && ViewBag.usuario == 1) || (ViewBag.status == 16 && ViewBag.usuario == 0))*@

                    @Ajax.ActionLink(" ", "OperacionObjetivosPTP", "MisEvaluaciones", new { id = item.id, Eval = item.Eval, Usr = ViewBag.usuario }, new AjaxOptions { UpdateTargetId = "DetalleObjetivosPTP", OnBegin = "AbreCierraDilogoEspera", OnComplete = "AbreCierraDilogoEspera()", OnSuccess = "AbrirObjetivosPTP" }, new { @class = "fa fa-edit", @style = "color: #FFF;", @title = "Editar" })
                    @Ajax.ActionLink(" ", "EliminaObjetivoPTP", "MisEvaluaciones", new { id = item.id}, new AjaxOptions { UpdateTargetId = "", OnBegin = "AbreCierraDilogoEspera", OnComplete = "AbreCierraDilogoEspera();VerificaSesionEnv()", OnSuccess = "loadObjetivosPTP()", Confirm = "¿Seguro desea eliminar el elemento?" }, new { @class = "fa fa-times", @style = "color: red;", @title = "Eliminar" })

                </div>
            </h3>
            <div style="padding: 10px;">
                <table class="table table-sm table-bordered table-striped">
                    <tr class="ObjetivosPTP">
                        <td style="background-color: #F9F9F9; font-weight: bold;  width: 50%;">
                            Objetivos
                            <p style="font-size: 12px; font-weight: normal; text-align: left;">
                                Enlista el apoyo que necesitas en tu puesto actual
                            </p>
                        </td>
                        <td style="width: 50%;">@item.ObjetivePTP</td>
                    </tr>
                    <tr class="ObjetivosPTP">
                        <td style="background-color: #F9F9F9; font-weight: bold; width: 50%;">
                            Acciones
                            <p style="font-size: 12px; font-weight: normal; text-align: left;">
                                Enumera los pasos a realizar para lograr el objetivo
                                (Aprendizaje autodirigido, aprendizaje en el aula, coaching o aprendizaje en el trabajo)
                            </p>
                        </td>
                        <td style="width: 50%;">@item.ActionPTP</td>
                    </tr>
                    <tr class="ObjetivosPTP">
                        <td style="background-color: #F9F9F9; font-weight: bold;">
                            ¿Para Cuándo?
                            <p style="font-size: 12px; font-weight: normal; text-align: left; width: 50%;">
                                Fecha límite para cuando deseas lograr tu objetivo
                            </p>

                        </td>
                        <td style="width: 50%;">@item.DateFin</td>
                    </tr>

                </table>
            </div>
        }


    }


</div>


<script>
    $(function () {
        $("#accordionObjetivosPTP").accordion({
            active: false,
            collapsible: true,
            heightStyle: "content"
        });
    });
</script>


