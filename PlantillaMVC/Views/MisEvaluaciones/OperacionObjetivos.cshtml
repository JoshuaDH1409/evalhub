<script type="text/javascript">
        $(document).ready(function () {
            var pesototal = '@ViewBag.PesoTotal';
            $('.DatePicker').datepicker({
            format: "dd/mm/yyyy"
            });
            var objeto = $(".oculto")
            objeto.hide();

            var forma = $("#Objetivos");
            $(forma).removeData("validator");
            //if ($(form).valid()) {
            $("#Objetivos").validate({
            submitHandler: function (form) {
            var ponderado = $("#ponderado").val();
            var total = parseInt(pesototal) + parseInt(ponderado);
            if (total <= 100) {
            $(form).ajaxSubmit();
            }
            else {
            alert("La suma de los ponderados de objetivos debe ser igual a 100. Revise los ponderados y vuelva a intentarlo. La suma actual es " + total);
            }
            }
            });
            $.validator.unobtrusive.parse(forma);
            });
</script>
<script>
    /* Evento para cuando el usuario libera la tecla escrita dentro del input */
    $('input,textarea').keyup(function () {
        /* Obtengo el valor contenido dentro del input */
        var value = $(this).val();

        /* Elimino todos los espacios en blanco que tenga la cadena delante y detrás */
        var value_without_space = value.trimStart();

        /* Muestro una alerta al usuario */
        //alert('El texto que ha ingresado contiene espacios y serán eliminados');

        /* Cambio el valor contenido por el valor sin espacios */
        $(this).val(value_without_space);
    });
</script>
