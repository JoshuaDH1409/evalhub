                <button type="button" name="button" class="btn btn-default btn-compress" data-toggle="collapse" data-target="#collapseDatos" aria-expanded="false" aria-controls="collapseExample">
                    <i class="fa fa-compress-alt"></i>
                </button>
            </div>

        </h4>
        <div class="collapse show" id="collapseDatos">
            <table class="table table-bordered table-sm table-striped">
                <thead></thead>
                <tbody>

                    <tr style="display:none">
                        <td>
                            @Html.LabelFor(m => m.sesion.Evaluacion.Status, new { @class = "etiqueta" })
                        </td>
                        <td>

                            @Html.TextBoxFor(m => m.sesion.Evaluacion.Status, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.sesion.Evaluacion.Status)
                        </td>
                    </tr>
                    <tr style="display:none">
                        <td>
                            @Html.LabelFor(m => m.sesion.Evaluacion.id, new { @class = "etiqueta" })
                        </td>
                        <td>

                            @Html.TextBoxFor(m => m.sesion.Evaluacion.id, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.sesion.Evaluacion.id)
                        </td>
                    </tr>
                    <tr style="display:none">
                        <td>
                            @Html.LabelFor(m => m.sesion.Login.id, new { @class = "etiqueta" })
                        </td>
                        <td>
                            @Html.TextBoxFor(m => m.sesion.Login.id, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.sesion.Login.id)
                        </td>
                    </tr>
                    <tr style="display:none">
                        <td>
                            @Html.LabelFor(m => m.sesion.Evaluacion.Activo, new { @class = "etiqueta" })
                        </td>
                        <td>

                            @Html.TextBoxFor(m => m.sesion.Evaluacion.Activo, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.sesion.Evaluacion.Activo)
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <strong>
                                Número de Empleado SAP:
                            </strong><br />
                            @Model.sesion.Login.id_sap
                            <span id="numeroEmpleado"></span>
                            <div style="visibility:hidden">

                                @Html.TextBoxFor(m => m.sesion.Login.id_sap, new { @readonly = "readonly", @style = "background-color:#eeeeee" })
                            </div>
                        </td>
                        <td>
                            <strong>
                                Nombre Completo:
                            </strong><br />
                            @Model.sesion.Login.NombreCompleto
                        </td>
                        <td>
                            <strong>
                                Periodo de Evaluaci&oacute;n:
                            </strong><br />
                            @Model.periodo.Llave
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <strong>
                                Puesto:
                            </strong><br />
                            @Model.sesion.Login.Puesto
                        </td>
                        <td>
                            <strong>
                                Dirección de Personal:
                            </strong><br />
                            @Model.sesion.Login.Division
                        </td>
                        @*<td>
                                <strong>
                                    &Aacute;rea de Personal:
                                </strong><br />
                                @Model.sesion.Login.Area
                            </td>*@
                    </tr>
                    <tr>
                        <td>
                            <strong>
                                Fecha de ingreso:
                            </strong><br />
                            @Model.sesion.Login.FechaIngresoTemp
                        </td>
                        <td>
                            <strong>
                                Antigüedad:
                            </strong><br />
                            @Model.sesion.Login.FechaAntiguedadTemp
                        </td>
                        <td></td>
                    </tr>
                    <tr>
                        <td colspan="3">
                            <div class="controls">
                                @if (Model.sesion.Evaluacion.Status == 0 || Model.sesion.Evaluacion.Status == 16)
                                {
                                    <label class="checkbox col-md-3" style="margin-top:-5px !important">
                                        @Html.RadioButtonFor(m => m.sesion.Evaluacion.Nivel, "1") Director <br /> (Director con reportes directos)

                                    </label>
                                    <label class="checkbox col-md-3">
                                        @Html.RadioButtonFor(m => m.sesion.Evaluacion.Nivel, "2") Gerente / Supervisor <br /> (Líder de personas)
                                    </label>

                                    <label class="checkbox col-md-3">
                                        @Html.RadioButtonFor(m => m.sesion.Evaluacion.Nivel, "3") Coordinador <br /> (Líder de personas)
                                    </label>

                                    <label class="checkbox col-md-3">
                                        @Html.RadioButtonFor(m => m.sesion.Evaluacion.Nivel, "4", new { Checked = "checked" }) Empleado
                                    </label>
                                }
                                else
                                {
                                    <div class="oculto" style="display:none;">
                                        @Html.TextAreaFor(m => m.sesion.Evaluacion.Nivel)
                                    </div>
                                    if (Model.sesion.Evaluacion.Nivel == 1)
                                    {
                                        <b>Director (Director con reportes directos)</b>
                                    }
                                    else if (Model.sesion.Evaluacion.Nivel == 2)
                                    {
                                        <b>Gerente / Supervisor (Líder de personas) </b>
                                    }
                                    else if (Model.sesion.Evaluacion.Nivel == 3)
                                    {
                                        <b>Coordinador (Líder de personas) </b>
                                    }
                                    else
                                    {
                                        <b>Empleado</b>
                                    }
                                }

                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
            <p>
               
            </p>
        </div>
    </div>



    <h4>
        Evaluador<span style="visibility:hidden" id="numEmpleadoJefe2NivelEvaluador"></span><span style="visibility:hidden" id="correoEvaluador"></span>
        <div class="btn-toolbar float-right">
