
@model Modelo.Clases.CEvaluacion
@{
    string statusEt = "";
    string porcen = "0";

    string panel1 = "";
    string panel2 = "";

    if (Model.periodo.Etapa <= 2)
    {
        panel1 = "in active";
    }

    if (Model.periodo.Etapa > 2)
    {
        panel2 = "in active";
    }
    statusEt = ViewBag.statusName;
    porcen = ViewBag.porc + "%";
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/fancyapps/fancybox@3.5.7/dist/jquery.fancybox.min.css" />
<script src="https://cdn.jsdelivr.net/gh/fancyapps/fancybox@3.5.7/dist/jquery.fancybox.min.js"></script>

@using (Ajax.BeginForm("GuardaClaseEvaluacion", "MisEvaluaciones", new AjaxOptions
{
    UpdateTargetId = "Principal",
    OnBegin = "AbreCierraDilogoEspera",
    OnComplete = "AbreCierraDilogoEspera();VerificaSesionEnv()",
    HttpMethod = "Post"
}, new { id = "MiEval", novalidate = "novalidate" }))
{
    @Html.AntiForgeryToken();
    <div class="progress">
        <div class="progress-bar" role="progressbar" aria-valuenow="@porcen.ToString()" aria-valuemin="0" aria-valuemax="100" style="width: @porcen.ToString()">
            <span class="progress-value">@statusEt.ToString()</span>
        </div>
    </div>
    <div class="alert alert-info">
        @{
            int usuarioInt = 0;
            if (ViewBag.usuario != null && int.TryParse(ViewBag.usuario.ToString(), out usuarioInt))
            {
                // Conversión exitosa
            }
        }
        @if ((Model.sesion.Evaluacion.Status == 13) && (usuarioInt == 1 || usuarioInt == 2))
        {
            <text>En esta fase deberás calificar cada uno de los objetivos de tu colaborador con base en el cumplimiento de estos y agregar comentarios de retroalimentación.</text>
        }
        else if ((Model.sesion.Evaluacion.Status == 13) && (usuarioInt == 0))
        {
            <text>Estimado Colaborador, tu Jefe inmediato ha calificado tu evaluación y se inició la etapa de calibración. Pronto recibirás tu calificación final.</text>
        }
        else
        {
            @ViewBag.statusDesc
        }
    </div>
    <div>
        <h4>
            Datos del periodo
            <div class="btn-toolbar float-right">
                <button type="button" name="button" class="btn btn-default btn-compress" data-toggle="collapse" data-target="#collapseHeader" aria-expanded="false" aria-controls="collapseHeader">
                    <i class="fa fa-compress-alt"></i>
                </button>
            </div>
        </h4>
        <div class="collapse show" id="collapseHeader">
            <table width="100%" class="table table-bordered table-sm table-striped">
                <thead>
                    <tr>
                        <th>Etapa</th>
                        <th>Periodo</th>
                        <th>País</th>
                        <th>Fecha inicio</th>
                        <th>Fecha fin</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.periodo.Activo == true)
                    {
                        <tr>
                            <td><b>@Model.periodo.EtapaDsc</b></td>
                            <td>@Model.periodo.Llave</td>
                            <td>@Model.periodo.PaisTempral</td>
                            @if (Model.periodo.Etapa == 0)
                            {
                                <td>@Model.periodo.StartDateObjTemp</td>
                                <td>@Model.periodo.FinishDateObjTemp</td>
                            }
                            @if (Model.periodo.Etapa == 1)
                            {
                                <td>@Model.periodo.StartDateEvaTemp</td>
                                <td>@Model.periodo.FinishDateEvaTemp</td>
                            }
                            @if (Model.periodo.Etapa == 2)
                            {
                                <td>@Model.periodo.StartDateCaliTemp</td>
                                <td>@Model.periodo.FinishDateCaliTemp</td>
                            }
                            @if (Model.periodo.Etapa == 3)
                            {
                                <td>@Model.periodo.StartDateEva2Temp</td>
                                <td>@Model.periodo.FinishDateEva2Temp</td>
                            }
                            @if (Model.periodo.Etapa == 4)
                            {
                                <td>@Model.periodo.StartDateCali2Temp</td>
                                <td>@Model.periodo.FinishDateCali2Temp</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div>
        <h4>
            Mis datos <span style="display:none" id="idEval"></span><span style="display:none" id="correoEmpleado"></span>

