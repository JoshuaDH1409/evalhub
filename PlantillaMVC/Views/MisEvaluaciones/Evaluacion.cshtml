                 $("#MiEval").validate({  // initialize the plugin
                    submitHandler: function (form) {  // fires on valid form

                        var status = $('#Sesion_Evaluacion_Status').val();

                        //alert('Status->'+status);
                        if (status == 0) {
                            var Objetivo = 0;
                            $('.Objetivos').each(function (index, value) {
                                Objetivo = Objetivo + 1;
                            });
                            if (Objetivo < 6) {
                                alert('debe de ingresar por lo menos 3 objetivos \n actuales->' + Objetivo);
                                return false;
                            }
                            Objetivo = 0;

                            var Competencias = 0;
                            $('.Competencias').each(function (index, value) {
                                Competencias = Competencias + 1;
                            });
                            if (Competencias <= 0) {
                                alert('debe de ingresar por lo menos una Competencia')
                                return false;
                            }
                            Competencias = 0;
                            return true;
                        }
                        else if (status == 1) {
                            var temp= $("#Sesion_Evaluacion_MotivoRechazoObj").val();
                            var aux= $("#TemporalObj").val();
                            if (temp == "" && aux == 1)
                            {
                                alert("Tiene que ingresar comentario de rechazo");
                                return false;
                            }
                            return true;
                        }
                        else if (status == 4)
                        {
                            var aux = 0;
                            var auxres = 0;
                            var TotalObj = 0;
                            var TotalComp = 0;
                            $('.AutoEvalCell').each(function (index, value) {
                                TotalObj = TotalObj + 1;
                                var cellText = $(this).html();
                                cellText = $.trim(cellText);
                                //alert(cellText);
                                if (cellText != '') {
                                    aux = aux + 1;
                                }

                            });

                            if (TotalObj > aux) {
                                alert('Se requiere comentar todos los objetivos a evaluar');
                                return false;
                            }
                            if (aux < 3) {
                                alert('Se debe de ingresar al menos 3 objetivos activos');
                                return false;
                            }


                            $('.ResultadoComp').each(function (index, value) {
                                TotalComp = TotalComp + 1;
                                var cellRes = $(this).html();
                                //alert(cellRes);
                                cellRes = $.trim(cellRes);
                                if (cellRes != '')
                                {
                                    auxres = auxres + 1;
                                }
                            });

                            //alert(auxres + '<>' + TotalComp);
                            if (TotalComp > auxres)
                            {
                                alert('Se requiere los resultados de todas las competencias');
                                return false;
                            }
                            else
                            {
                                return true;
                            }

                        }
                        else if (status == 5) {
                            var aux = 0;

                            var ContadorPart = 0;
                            $('.JefeEvalCell').each(function (index, value) {
                                var secondElementeInTable = $(this).prev().prev().prev();
                                var attr = secondElementeInTable.attr('bgcolor');

                                if (attr !== "#F5A9BC") {
                                    var cellTemp = $(this).html();
                                    cellTemp = $.trim(cellTemp);
                                    if (cellTemp == '') {
                                        aux = 1;
                                        return false;
                                    }
                                    ContadorPart = ContadorPart + 1;
                                }
                            });

                            if (aux == 1) {
                                alert('Se requiere agregar un comentario por cada objetivo actualizado');
                                aux = 0;
                                return false;
                            }
                            else {
                                return true;
                            }

                        }
                        else if (status == 6)
                        {
                            var ContadorGen = 0;
                            $('.JefeEvalCell').each(function (index, value) {
                                var cellText = $(this).html();
                                cellText = $.trim(cellText);

                                if (cellText != '0') {
                                    var ContadorPart = 0;
                                    $('.CalFinal').each(function (index, value) {
                                        var cellTemp = $(this).html();
                                        cellTemp = $.trim(cellTemp);
                                        //alert('¡¡¡¡ cellText->' + cellText + '(1)  cellTemp->' + cellTemp);
                                        if (ContadorPart == ContadorGen && cellTemp == '0'){
                                            aux = 1;
                                            return false;
                                        }
                                        ContadorPart = ContadorPart + 1;
                                    });
                                }
                                ContadorGen = ContadorGen + 1;
                            });

                            if (aux == 1) {
                                alert('Ingrese la calificación acordada que requiere');
                                aux = 0;
                                return false;
                            }
                            else
                            {
                                return true;
                            }
                        }
                        if (status == 7) {
                            var temp = $("#Sesion_Evaluacion_ComentariosSegundoNivel").val();
                            var aux = $("#TemporalCalif").val();
                            if (temp == "" && aux == 1) {
                                alert("Tiene que ingresar comentario de rechazo");
                                return false;
                            }
                            return true;
                        }
                        if (status == 9) {
                            var temp = $("#Sesion_Evaluacion_MotivoCalibracion").val();
                            if (temp == "") {
                                alert("Tiene que ingresar un comentario para calibrar");
                                return false;
                            }
                            return true;
                        }
                        if (status == 10) {
                            //alert('entra');
                            var aux = 0;
                            var auxres = 0;
                            $('.AutoEvalCell2').each(function (index, value) {
                                var cellText = $(this).html();
                                cellText = $.trim(cellText);
                                //alert(cellText);
                                if (cellText == '') {
                                    aux = 1;
                                }

                            });

                            if (aux == 1) {
                                alert('Es necesario que ingrese calificación como comentario de todos los objetivos');
                                return false;
                            }


                            $('.ResultadoComp').each(function (index, value) {
                                var cellRes = $(this).html();
                                cellRes = $.trim(cellRes);
                                if (cellRes == '') {
                                    //alert('celda->' + cellRes);
                                    auxres = 1;
                                }
                            });

                            if (auxres == 1) {
                                alert('Es necesario evaluar todas las competencias');
                                return false;
                            }
                            else
                            {
                                return true;
                            }


                        }
                        if (status == 11) {
                            var aux = 0;
                            var auxres = 0;
                            $('.JefeEvalCell2').each(function (index, value) {
                                var cellText = $(this).html();
                                cellText = $.trim(cellText);
                                //alert(cellText);
                                if (cellText == '') {
                                    aux = 1;
                                }

                            });

                            if (aux == 1) {
                                alert('Es necesario que ingrese calificación como comentario de todos los objetivos');
                                return false;
                            } else {
                                return true;
                            }

                        }
                        if (status == 12) {
                            var aux = 0;
                            var auxres = 0;
                            $('.CalFinal2').each(function (index, value) {
                                var cellText = $(this).html();
                                cellText = $.trim(cellText);
                                //alert(cellText);
                                if (cellText == '') {
                                    aux = 1;
                                }

                            });

                            if (aux == 1) {
                                alert('Es necesario que ingrese calificación como comentario de todos los objetivos');
                                return false;
                            } else {
                                return true;
                            }

                        }
                        if (status == 13) {
                            var temp = $("#Sesion_Evaluacion_ComentariosSegundoNivel2").val();
                            if (temp == "") {
                                alert("Tiene que ingresar un comentario");
                                return false;
                            }
                            return true;
                        }
                        if (status == 15) {
                            var temp = $("#Sesion_Evaluacion_MotivoCalibracion2").val();
                            if (temp == "") {
                                alert("Tiene que ingresar un comentario para calibrar");
                                return false;
                            }
                            return true;
                        }
                        if (status == 16) {// agregado para manejar los extemporaneos
                            var Objetivo = 0;
                            $('.Objetivos').each(function (index, value) {
                                Objetivo = Objetivo + 1;
                            });
                            if (Objetivo < 6) {
                                alert('debe de ingresar por lo menos 3 objetivos \n actuales->' + Objetivo/2 );
                                return false;
                            }
                            Objetivo = 0;

                            var Competencias = 0;
                            $('.Competencias').each(function (index, value) {
                                Competencias = Competencias + 1;
                            });
                            if (Competencias <= 0) {
                                alert('debe de ingresar por lo menos una Competencia')
                                return false;
                            }
                            Competencias = 0;
                            return true;
                        }
                        else if (status == 17) {
                            var temp = $("#Sesion_Evaluacion_MotivoRechazoObj").val();
                            var aux = $("#TemporalObj").val();
                            if (temp.trim() == "" && aux == 1) {
                                alert("Tiene que ingresar comentario de rechazo");
                                return false;
                            }
                            return true;
                        }

                        return false;
                    }
                });

