
@model Modelo.ECompetemces

<div id="RespuestaObjetivos" style="width:100%; height:100%;">

    @using (Ajax.BeginForm("GuardaCompetencias", "MisEvaluaciones", new { Eval = ViewBag.Eval, Usr = ViewBag.Usr }, new AjaxOptions
    {
        UpdateTargetId = "RespuestaObjetivos",
        OnBegin = "AbreCierraDilogoEspera",
        OnComplete = "AbreCierraDilogoEspera(); loadCompetences(); CerrarCompetencias();",
        HttpMethod = "Post"
    }, new { id = "FormCompetencias", novalidate = "novalidate" }))
    {
        @Html.AntiForgeryToken();

        <div style="color:#FF0000;"> @ViewBag.Error </div>

        <table class="table-pop">
            @*Validar que no se repitan competencias*@
            <tr class="oculto">
                <td>
                    @Html.LabelFor(m => m.id, new { @class = "etiqueta" })
                </td>
                <td>
                    @Html.TextBoxFor(m => m.id, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.id)
                </td>
            </tr>
            <tr class="oculto">
                <td>
                    @Html.LabelFor(m => m.Eval, new { @class = "etiqueta" })
                </td>
                <td>
                    @Html.TextBoxFor(m => m.Eval, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Eval)
                </td>
            </tr>
            <tr class="oculto">
                <td>
                    @Html.LabelFor(m => m.Etapa, new { @class = "etiqueta" })
                </td>
                <td>
                    @Html.TextBoxFor(m => m.Etapa, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Etapa)
                </td>
            </tr>


            @*@if (ViewBag.status == 0)
        {*@

            @if ((ViewBag.status == 0 && Model.Etapa == 3) || (ViewBag.status == 5 && Model.Etapa != 2) || (ViewBag.status == 10 && Model.Etapa != 6) || (ViewBag.status == 11 && Model.Etapa != 7))
            {
                <tr>
                    <td>
                        @Html.LabelFor(m => m.titulo, new { @class = "etiqueta" })
                    </td>
                    <td style="text-align: left">
                        @Html.DropDownListFor(m => m.titulo, (ViewData["Competencias"] as List<SelectListItem>), "--SELECCIONA--", new { @class = "form-control", @style = "background-color:#eeeeee", @readonly = "readonly" })
                        @Html.ValidationMessageFor(m => m.titulo)
                        <br />
                    </td>
                </tr>

                <tr>
                    <td>
                        @Html.LabelFor(m => m.actividades, new { @class = "etiqueta" })
                    </td>
                    <td>
                        @Html.TextAreaFor(m => m.actividades, new { @class = "form-control", @readonly = "readonly", @style = "background-color:#eeeeee" })
                        @Html.ValidationMessageFor(m => m.actividades)
                        <br />
                    </td>
                </tr>
            }
            else
            {
                <tr>
                    <td>
                        @Html.LabelFor(m => m.titulo, new { @class = "etiqueta" })
                    </td>
                    <td style="text-align: left">
                        @Html.DropDownListFor(m => m.titulo, (ViewData["Competencias"] as List<SelectListItem>), "--SELECCIONA--", new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.titulo)
                        <br />
                    </td>
                </tr>

                <tr>
                    <td>
                        @Html.LabelFor(m => m.actividades, new { @class = "etiqueta" })
                    </td>
                    <td>
                        @Html.TextAreaFor(m => m.actividades, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.actividades)
                        <br />
                    </td>
                </tr>
            }

            @if (ViewBag.status != 0 && ViewBag.status != 2 && ViewBag.status != 16 && ViewBag.status != 10 && ViewBag.status != 11)
            {
                if (ViewBag.Usr == 0)
                {
                    <tr>
                        <td>
                            @Html.LabelFor(m => m.resultados, new { @class = "etiqueta" })
                        </td>
                        <td>
                            @Html.TextAreaFor(m => m.resultados, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.resultados)
                        </td>
                    </tr>
                }
                else
                {
                    <tr class="oculto">
                        <td>
                            @Html.LabelFor(m => m.resultados, new { @class = "etiqueta" })
                        </td>
                        <td>
                            @Html.TextAreaFor(m => m.resultados, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.resultados)
                        </td>
                    </tr>
                    <tr>
                        <td>
                            @Html.LabelFor(m => m.resultadosEvaluador, new { @class = "etiqueta" })
                        </td>
                        <td>
                            @Html.TextAreaFor(m => m.resultadosEvaluador, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.resultadosEvaluador)
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr class="oculto">
                    <td>
                        @Html.LabelFor(m => m.resultados, new { @class = "etiqueta" })
                    </td>
                    <td>
                        @Html.TextAreaFor(m => m.resultados, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.resultados)
                    </td>
                </tr>
                <tr class="oculto">
                    <td>
                        @Html.TextAreaFor(m => m.resultadosEvaluador, new { @class = "form-control" })
                    </td>
                </tr>
                if (ViewBag.status == 10 || ViewBag.status == 11)
                {
                    if (ViewBag.Usr == 0)
                    {
                        <tr>
                            <td>
                                @Html.LabelFor(m => m.resultados, new { @class = "etiqueta" })
                            </td>
                            <td>
                                @Html.TextAreaFor(m => m.resultados2, new { @class = "form-control", required = true })
                                @Html.ValidationMessageFor(m => m.resultados)
                            </td>
                        </tr>
                    }
                    else
                    {
                        <tr class="oculto">
                            <td>
                                @Html.TextAreaFor(m => m.resultados2, new { @class = "form-control", required = true })
                            </td>
                        </tr>
                        <tr>
                            <td>
                                @Html.LabelFor(m => m.resultados2Evaluador, new { @class = "etiqueta" })
                            </td>
                            <td>
                                @Html.TextAreaFor(m => m.resultados2Evaluador, new { @class = "form-control", required = true })
                                @Html.ValidationMessageFor(m => m.resultados2Evaluador)
                            </td>
                        </tr>
                    }
                }
            }


        </table>
        <div class="modal-footer" style="padding-bottom: 0px;">
            <p style="text-align:right;">
                <button type="submit" id="enviar" class="btn btn-success fa fa-check"> <x style="font-family:Arial"> Guardar</x> </button>  <button type="button" class="btn btn-danger fa fa-times" data-dismiss="modal">  <x style="font-family:Arial"> Cerrar</x></button>
            </p>
        </div>


    }
</div>

<script type="text/javascript">
    $(document).ready(function () {
        $('.DatePicker').datepicker({
            format: "dd/mm/yyyy"
        });
        var objeto = $(".oculto")
        objeto.hide();

        var form = $("#FormCompetencias");
        $(form).removeData("validator");
        $.validator.unobtrusive.parse(form);


        $("#titulo option").each(function () {

           // alert("index->" + $(this).text().indexOf("Individuales |"));
            if ($(this).text().indexOf("Individuales |") >= 0 ) {
                $(this).css('color','#F8CB53');
            }
            else if ($(this).text().indexOf("Gente |") >= 0 ) {
                $(this).css('color', '#5AA767');
            }
            else if ($(this).text().indexOf("Negocio |") >= 0 ) {
                $(this).css('color', '#00B2E9');
            }
        });
    });
</script>
<script>
    /* Evento para cuando el usuario libera la tecla escrita dentro del input */
    $('input,textarea').keyup(function () {
        /* Obtengo el valor contenido dentro del input */
        var value = $(this).val();

        /* Elimino todos los espacios en blanco que tenga la cadena delante y detrás */
        var value_without_space = value.trimStart();

        /* Muestro una alerta al usuario */
        //alert('El texto que ha ingresado contiene espacios y serán eliminados');

        /* Cambio el valor contenido por el valor sin espacios */
        $(this).val(value_without_space);
    });
</script>
