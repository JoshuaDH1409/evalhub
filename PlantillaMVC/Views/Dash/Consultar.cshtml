@if (Model != null)
{
    using (Html.BeginForm("Download", "Dash", new { Pais =String.Join(",",(ViewBag.Pais as List<int>)), Periodo = String.Join(",",(ViewBag.Periodo as List<int>)), Area = @ViewBag.Area, Actual = @ViewBag.Actual }, FormMethod.Post, new { enctype = "multipart/form-data", @style = "display:inline-block" }))
    {
        <button type="submit" class="fa fa-file-excel" style="background: none; border:none;color:#428bca; font-size: 2.3em"></button>
    }
    @Html.ActionLink(" Descarga comentarios", "Comments", "Dash", new { Pais = String.Join(",",(ViewBag.Pais as List<int>)), Periodo = String.Join(",",(ViewBag.Periodo as List<int>)) }, new { @class = "btn btn-success fa fa-file-excel", @style = "margin: 0 5px;" })

    @Html.ActionLink(" Descarga competencias", "Competences", "Dash", new { Pais = String.Join(",",(ViewBag.Pais as List<int>)), Periodo = String.Join(",",(ViewBag.Periodo as List<int>)) }, new { @class = "btn btn-success fa fa-file-excel", @style = "margin: 0 5px;" })
}

<table id="tableEmpleados" class="display">
    <thead>
        <tr>
            <th>Num Sap</th>
            <th>Nombre Completo</th>
            <th>Puesto</th>
            <th>Dirección</th>
            @*<th>Area</th>*@
            <th>PDF</th>
            <th>Etapa</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null)
        {
            foreach (Modelo.Clases.CSessionEval item in Model)
            {
                <tr>
                    <td>@item.Login.id_sap</td>
                    <td>@item.Login.NombreCompleto</td>
                    <td>@item.Login.Puesto</td>
                    <td>@item.Login.Division</td>
                    @*<td>@item.login.Area</td>*@

                    @{
                        //NUEVO REQUERIMIENTO: SI EL INICIO DE LA EVALUACIÓN ES A PARTIR DEL 2024 SE DEBE
                        //DESCARGAR EL NUEVO FORMATO, EN CASO CONTRARIO, SE DESCARGA EL ANTERIOR.
                        // Convertimos los ticks a DateTime
                        DateTime startDate = new DateTime(item.Evaluacion.periodo);

                        // Determinamos el método a usar basado en el año
                        string downloadAction = startDate.Year >= 2024 ? "DownloadPdfNew" : "DownloadPdfDetailed";
                    }

                    <td>
                        @using (Html.BeginForm("DownloadPdfDetailed", "MiHistorial", new { Id = item.Evaluacion.id }, FormMethod.Post, new { enctype = "multipart/form-data", @style = "text-align: center; margin-top: 10px;" }))
                        {
                            <button type="submit" class="btn btn-default fa fa-file-pdf fontIcons"> </button>
                        }
                    </td>
                    @switch (item.Evaluacion.Status)
                    {
                        case 0:
                            <td><b> Iniciado</b></td>
                            break;
                        case 1:
                            <td><b>Objetivos cargados</b></td>
                            break;
                        case 2:
                            <td><b>Objetivos rechazados</b></td>
                            break;
                        case 3:
                            <td><b>Objetivos aprobados</b></td>
                            break;
                        case 4:
                            <td><b>Inicio evaluación medio año</b></td>
                            break;
                        case 5:
                            <td><b>Objetivos autoevaluados medio año</b></td>
                            break;
                        case 6:
                            <td><b>Objetivos evaluados medio año</b></td>
                            break;
                        case 7:
                            <td><b>Evaluación segundo nivel</b></td>
                            break;
                        case 8:
                            <td><b>Cerrada</b></td>
                            break;
                        case 9:
                            <td><b>Calibración</b></td>
                            break;
                        case 10:
                            <td><b>Inicio evaluación Fin de Año</b></td>
                            break;
                        case 11:
                            <td><b>Objetivos autoevaluados Fin de año</b></td>
                            break;
                        case 12:
                            <td><b>Objetivos evaluados</b></td>
                            break;
                        case 13:
                            <td><b>Calibración</b></td>
                            break;
                        case 14:
                            <td><b>Cerrada fin de año</b></td>
                            break;
                        case 15:
                            <td><b>Calibrada/Cerrada fin de año</b></td>
                            break;
                        case 16:
                            <td><b>Pendiente carga de objetivos (nuevo ingreso)</b></td>
                            break;
                        case 17:
                            <td><b>Objetivos cargados (nuevo ingreso)</b></td>
                            break;
                        case 18:
                            <td><b>Objetivos rechazados (nuevo ingreso)</b></td>
                            break;
                    }
                </tr>
            }
        }
    </tbody>
</table>


<script type="text/javascript">

    $(document).ready(function () {
        var tablaCliente = $('#tableEmpleados').DataTable();
    });
</script>


