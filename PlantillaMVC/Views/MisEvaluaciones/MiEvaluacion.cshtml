                    @Ajax.ActionLink(" Detalle", "DetalleObj", "MisEvaluaciones", new { eval = Model.sesion.Evaluacion.id }, new AjaxOptions { UpdateTargetId = "DetalleObj", OnBegin = "AbreCierraDilogoEspera", OnComplete = "AbreCierraDilogoEspera();VerificaSesionEnv()", OnSuccess = "AbrirObjetivos();VerificaSesionEnv()" }, new { @class = "btn btn-default fa fa-search-plus", @style = "color:#004b8d" })
                </td>
                <td style="width: 85%">
