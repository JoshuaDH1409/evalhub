<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - EvalHub</title>

    <link href="~/Content/bootstrap-datepicker.css" rel="stylesheet" />
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)

    @Styles.Render("~/Content/css")
    @Styles.Render("~/Content/jqueryui")
    @Scripts.Render("~/bundles/modernizr")
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/bundles/jqueryui")
    <script src="~/Scripts/jquery.unobtrusive-ajax.js"></script>
    <script src="~/Scripts/DataTables/jquery.dataTables.js"></script>
    <link href="~/Content/DataTables/css/jquery.dataTables.css" rel="stylesheet" />
    <script src="~/Scripts/bootstrap-datepicker.js"></script>
    <script type="text/javascript" src="https://www.gstatic.com/charts/loader.js"></script>
    <link href="~/Content/jquery-clockpicker.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-clockpicker.min.js"></script>
    <script src="~/Scripts/DataTables/dataTables.rowGroup.js"></script>
    <link href="~/Content/DataTables/css/rowGroup.dataTables.css" rel="stylesheet" />
    <script type="text/javascript">
        function AbreCierraDilogoEspera() {
            if ($('#myModal').hasClass('show')) {
                $('#myModal').modal('hide');
                document.getElementById('myModal').style.pointerEvents = 'auto';
            }
            else {
                document.getElementById('myModal').style.pointerEvents = 'none';
                $('#myModal').modal('show');
            }
        }
    </script>
</head>
<body class="evalhub-body">
    <div class="container evalhub-shell">
        <header class="row evalhub-header align-items-center">
            <div class="col-3">
                <a href="~/" class="evalhub-brand">
                    <img src="~/Imgs/evalhub-logo.png" alt="EvalHub" class="evalhub-logo" />
                </a>
            </div>
            <div class="col-9 evalhub-header-title">
                <h2>EvalHub</h2>
                <p class="evalhub-subtitle">Sistema de evaluación de desempeño</p>
                <span class="evalhub-page-title">@ViewBag.Titulo</span>
            </div>
        </header>
        <div class="row">
            <div class="col-md-12 evalhub-userbar"><b>@ViewBag.NomUsr</b></div>
        </div>
        <br />
        <div class="row">
            <div class="col-md-3">
                @Html.Partial("_Menu")
            </div>
            <div class="col-md-9 evalhub-main">
                @RenderBody()
            </div>
        </div>
    </div>
    <footer class="col-md-12 foot-style evalhub-footer">
        <div class="evalhub-footer-inner">
            <p>EvalHub — evaluaciones de desempeño | @ViewBag.Titulo</p>
            <p>&copy; @DateTime.Now.Year · Proyecto de portafolio · ver 3.0</p>
        </div>
        <div class="evalhub-footer-logo">
            <img src="~/Imgs/LogoB.PNG" alt="EvalHub" />
        </div>
    </footer>

    <div class="modal" id='myModal'>
        <div class="modal-header">
            <h3 id="myModalLabel" style="color:white">Cargando:</h3>
        </div>
        <div class="modal-body" style="text-align:center">
            <img src="~/Imgs/carga.gif" style="width:20%; height:20%;" alt="Cargando…" />
        </div>
    </div>
</body>
</html>
