                <tr style="display:none">
                    <td>
                        @Html.LabelFor(m => m.Sesion.Evaluacion.Status, new { @class = "etiqueta" })
                    </td>
                    <td>

                        @Html.TextBoxFor(m => m.Sesion.Evaluacion.Status, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Sesion.Evaluacion.Status)
                    </td>
                </tr>
                <tr style="display:none">
                    <td>
                        @Html.LabelFor(m => m.Sesion.Evaluacion.id, new { @class = "etiqueta" })
                    </td>
                    <td>

                        @Html.TextBoxFor(m => m.Sesion.Evaluacion.id, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Sesion.Evaluacion.id)
