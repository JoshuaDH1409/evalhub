<script type="text/javascript">
    $('#Clock1').clockpicker();
    $('#Clock2').clockpicker();
    $('#Clock3').clockpicker();
    $(document).ready(function () {


        var objeto = $(".oculto")
        objeto.hide();

        //$('.datetimepickerTime').datetimepicker({
        //    pickDate: false,
        //    pickSeconds: false
        //});
        //$(".datetimepickerTime").datetimepicker().on("changeDate", function (e) {
        //    e.date = new Date(e.date.setMinutes(0));
        //});

        $('.DatePicker').datepicker({
            format: "dd/mm/yyyy"
        });

        var form = $("#Periodo");
        $(form).removeData("validator");
        $.validator.unobtrusive.parse(form);
        $("#Country").rules("remove", "required");//remover reglas

        $("#StartDateObjTemp").rules("remove");//remover reglas
        $("#FinishDateObjTemp").rules("remove");//remover reglas

        $("#StartDateEvaTemp").rules("remove");//remover reglas
        $("#FinishDateEvaTemp").rules("remove");//remover reglas

        $("#StartDateCaliTemp").rules("remove");//remover reglas
        $("#FinishDateCaliTemp").rules("remove");//remover reglas

        $("#StartDateEva2Temp").rules("remove");//remover reglas
        $("#FinishDateEva2Temp").rules("remove");//remover reglas

        $("#StartDateCali2Temp").rules("remove");//remover reglas
        $("#FinishDateCali2Temp").rules("remove");//remover reglas
        //var Temp = $("#id").val();

    });

    $("#MiEval").validate({  // initialize the plugin
        submitHandler: function (form) {  // fires on valid form

            var Objetivosinicio = $("#StartDateObjTemp").val();
            var ObjetivosFin = $("#FinishDateObjTemp").val();

            var Eval1inicio = $("#StartDateEvaTemp").val();
            var Eval1fin = $("#FinishDateEvaTemp").val();

            var Calib1inicio = $("#StartDateCaliTemp").val();
            var Calib1fin = $("#FinishDateCaliTemp").val();

            var Eval2inicio = $("#StartDateEva2Temp").val();
            var Eval2fin = $("#FinishDateEva2Temp").val();

            var Calib2Inicio = $("#StartDateCali2Temp").val();
            var Calib2Fin = $("#FinishDateCali2Temp").val();

            var Bandera = false;

            if (Objetivosinicio = !'') {
                if (!$("#StartDateObjTemp").attr("value").match(/^([0-9]{2}\/[0-9]{2}\/[0-9]{4})$/)) {
                    Bandera = true;
                }
            }
            if (ObjetivosFin = !'') {
                if (!$("#FinishDateObjTemp").attr("value").match(/^([0-9]{2}\/[0-9]{2}\/[0-9]{4})$/)) {
                    Bandera = true;
                }
            }


            if (Eval1inicio = !'') {
                if (!$("#StartDateEvaTemp").attr("value").match(/^([0-9]{2}\/[0-9]{2}\/[0-9]{4})$/)) {
                    Bandera = true;
                }
            }
            if (Eval1fin = !'') {
                if (!$("#FinishDateEvaTemp").attr("value").match(/^([0-9]{2}\/[0-9]{2}\/[0-9]{4})$/)) {
                    Bandera = true;
                }
            }




            if (Calib1inicio = !'') {
                if (!$("#StartDateCaliTemp").attr("value").match(/^([0-9]{2}\/[0-9]{2}\/[0-9]{4})$/)) {
                    Bandera = true;
                }
            }
            if (Calib1fin = !'') {
                if (!$("#FinishDateCaliTemp").attr("value").match(/^([0-9]{2}\/[0-9]{2}\/[0-9]{4})$/)) {
                    Bandera = true;
                }
            }



            if (Eval2inicio = !'') {
                if (!$("#StartDateEva2Temp").attr("value").match(/^([0-9]{2}\/[0-9]{2}\/[0-9]{4})$/)) {
                    Bandera = true;
                }
            }
            if (Eval2fin = !'') {
                if (!$("#FinishDateEva2Temp").attr("value").match(/^([0-9]{2}\/[0-9]{2}\/[0-9]{4})$/)) {
                    Bandera = true;
                }
            }




            if (Calib2Inicio = !'') {
                if (!$("#StartDateEva2Temp").attr("value").match(/^([0-9]{2}\/[0-9]{2}\/[0-9]{4})$/)) {
                    Bandera = true;
                }
            }
            if (Calib2Fin = !'') {
                if (!$("#FinishDateEva2Temp").attr("value").match(/^([0-9]{2}\/[0-9]{2}\/[0-9]{4})$/)) {
                    Bandera = true;
                }
            }

            if (Bandera) {
                return false;
            } else {
                alert('verifique el formato de las fechas');
                return true;
            }

        }
    });


</script>
