@model Modelo.EPersonalDP

<div>
    <h2>@(ViewData["Editar"] != null && (bool)ViewData["Editar"] ? "Editar Objetivo" : "Nuevo Objetivo")</h2>

    <div style="color:#FF0000;"> @ViewBag.Error </div>

    <div id="RespuestaObjetivos">
        @using (Ajax.BeginForm("GuardaObjetivosPDP", "MisEvaluaciones", new { Eval = ViewBag.Eval, Usr = ViewBag.Usr }, new AjaxOptions
        {
            UpdateTargetId = "TblObjetivosPDP",
            OnBegin = "AbreCierraDilogoEspera",
            OnComplete = "AbreCierraDilogoEspera(); loadObjetivosPDP(); CerrarObjetivosPDP();",
            HttpMethod = "Post"
        }, new { id = "ObjetivosPDP", novalidate = "novalidate" }))
        {
            @Html.AntiForgeryToken();

        <table class="table-pop">


            <tr class="oculto">
                <td>
                    @Html.LabelFor(m => m.id, new { @class = "etiqueta" })
                </td>
                <td>
                    @Html.TextBoxFor(m => m.id, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.id)
                </td>
            </tr>
            <tr class="oculto">
                <td>
                    @Html.LabelFor(m => m.Eval, new { @class = "etiqueta" })
                </td>
                <td>
                    @Html.TextBoxFor(m => m.Eval, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Eval)
                </td>
            </tr>

            <tr>
                <td style="width: 50%; text-align: left;">
                    @Html.LabelFor(m => m.ObjetivePDP, new { @class = "etiqueta" })
                    <p style="font-size: 12px; font-weight: normal; text-align: left;">
                        ¿Cuáles son los objetivos ambiciosos, de crecimiento y las aspiraciones más allá del tu rol actual?
                    </p>
                </td>
                <td style="width: 50%; text-align: left;">
                    @Html.TextAreaFor(m => m.ObjetivePDP, new { @class = "form-control", @rows = "4", required = true })
                    @Html.ValidationMessageFor(m => m.ObjetivePDP, "", new { @class = "text-danger" })
                </td>
            </tr>
            <tr>
                <td style="width: 50%; text-align: left;">
                    @Html.LabelFor(m => m.actionPDP, new { @class = "etiqueta" })
                    <p style="font-size: 12px; font-weight: normal; text-align: left;">
                        ¿Cuál es tu motivación para alcanzar estas aspiraciones?
                    </p>
                </td>
                <td style="width: 50%; text-align: left;">
                    @Html.TextAreaFor(m => m.actionPDP, new { @class = "form-control", @rows = "4", required = true })
                    @Html.ValidationMessageFor(m => m.actionPDP, "", new { @class = "text-danger" })
                </td>
            </tr>
            <tr>
                <td style="width: 50%; text-align: left;">
                    @Html.LabelFor(m => m.dateFinish, new { @class = "etiqueta" })
                    <p style="font-size: 12px; font-weight: normal; text-align: left;">
                        ¿Qué necesitas hacer y/o qué apoyo necesitas para lograr tus aspiraciones profesionales? (estudios, proyectos específicos, formación, etc.)
                    </p>
                </td>
                <td style="width: 50%; text-align: left;">
                    @Html.TextAreaFor(m => m.dateFinish, new { @class = "form-control", @rows = "4", required = true })
                    @Html.ValidationMessageFor(m => m.dateFinish, "", new { @class = "text-danger" })
                </td>
            </tr>

            <tr>
                <td style="width: 50%; text-align: left;">
                    @Html.LabelFor(m => m.ComAutoPDP, new { @class = "etiqueta" })
                    <p style="font-size: 12px; font-weight: normal; text-align: left;">
                    </p>

                </td>
                <td style="width: 50%; text-align: left;">
                    @Html.TextBoxFor(m => m.ComAutoPDP, new { @class = "form-control DatePicker", required = true })
                    @Html.ValidationMessageFor(m => m.ComAutoPDP, "", new { @class = "text-danger" })
                </td>

            </tr>

            <tr>
                <td style="width: 50%; text-align: left;">
                    @Html.LabelFor(m => m.ComEvaluadorPDP, new { @class = "etiqueta" })
                    <p style="font-size: 12px; font-weight: normal; text-align: left;">
                    </p>

                </td>
                <td style="width: 50%; text-align: left;">
                    @Html.TextBoxFor(m => m.ComEvaluadorPDP, new { @class = "form-control DatePicker", required = true })
                    @Html.ValidationMessageFor(m => m.ComEvaluadorPDP, "", new { @class = "text-danger" })
                </td>
            </tr>

        </table>


            <div class="modal-footer" style="padding-bottom: 0px;">
                <p style="text-align: right;">
                    <button type="submit" id="enviar" class="btn btn-success fa fa-check"> <x style="font-family:Arial"> Guardar</x> </button>  <button type="button" class="btn btn-danger fa fa-times" data-dismiss="modal">  <x style="font-family:Arial"> Cerrar</x></button>
                </p>
            </div>

        }
    </div>


</div>


@*<script src="http://malsup.github.com/jquery.form.js"></script>*@

<script type="text/javascript">
    $(document).ready(function () {
        var objeto = $(".oculto")
        objeto.hide();

        var forma = $("#ObjetivosPDP");
        $(forma).removeData("validator");
        $("#ObjetivosPDP").validate({
            submitHandler: function (form) {
                $(form).ajaxSubmit();
            }
        });
        $.validator.unobtrusive.parse(forma);

    });
</script>

<script>
    /* Evento para cuando el usuario libera la tecla escrita dentro del input */
    $('input,textarea').keyup(function () {
        /* Obtengo el valor contenido dentro del input */
        var value = $(this).val();

        /* Elimino todos los espacios en blanco que tenga la cadena delante y detrás */
        var value_without_space = value.trimStart();

        /* Muestro una alerta al usuario */
        //alert('El texto que ha ingresado contiene espacios y serán eliminados');

        /* Cambio el valor contenido por el valor sin espacios */
        $(this).val(value_without_space);
    });
</script>
