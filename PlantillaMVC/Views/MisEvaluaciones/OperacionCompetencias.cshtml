        <div class="modal-footer" style="padding-bottom: 0px;">
            <p style="text-align:right;">
                <button type="submit" id="enviar" class="btn btn-success fa fa-check"> <x style="font-family:Arial"> Guardar</x> </button>  <button type="button" class="btn btn-danger fa fa-times" data-dismiss="modal">  <x style="font-family:Arial"> Cerrar</x></button>
            </p>
        </div>


    }
</div>

@{
    var ListValues = "[";
    var ListText = "[";
    var ListId = "[";
    var SubComp = (List<Modelo.ECatSubComp>)ViewBag.Subcompetencias;
    foreach (var item in SubComp)
    {
        ListValues = $"{ListValues}\"{item.id}\", ";
        ListText = $"{ListText}\"{item.SubCompetencia}\",";
        ListId = $"{ListId}\"{item.idCatComp}\",";
    }
    ListValues = ListValues.TrimEnd(',');
    ListText = ListText.TrimEnd(',');
    ListId = ListId.TrimEnd(',');
    ListValues = string.Concat(ListValues, "]");
    ListText = string.Concat(ListText, "]");
    ListId = string.Concat(ListId, "]");
}



<script type="text/javascript">
    /*var lblSubComp = document.getElementById("lblSubComp")*/
    var CatCompList = document.getElementById("CatCompList")
    var CatSubCompList = document.getElementById("CatSubCompList")
    var arrayValues = @Html.Raw(ListValues);
    var arrayText = @Html.Raw(ListText);
    var arrayId = @Html.Raw(ListId);

    CatCompListStyle()

        @if(Model.Subtitulo != 0)
    {
        @Html.Raw($"FillCatSubCompList({Model.Subtitulo})")
    }

    function CatCompListStyle() {
        Array.from(CatCompList.children).forEach(function (item, index) {

            if (item.text.indexOf("Individuales |") >= 0) {
                item.style.color = "#F8CB53"
            }
            if (item.text.indexOf("Gente |") >= 0) {
                item.style.color = "#5AA767"
            }
            if (item.text.indexOf("Negocio |") >= 0) {
                item.style.color = "#00B2E9"
            }
        })



    }


    function FillCatSubCompList(Id) {
        var color = Array.from(CatCompList.children)[CatCompList.selectedIndex].style.color
        CatCompList.style.color = color

        var PlaceHolder = document.createElement("option")
        PlaceHolder.text = "--SELECCIONA--"
        PlaceHolder.value = ""
        PlaceHolder.style.color = color

        CatSubCompList.innerHTML = ""
        CatSubCompList.style.color = color
        CatSubCompList.add(PlaceHolder)

        arrayId.forEach(function (idcomp, index) {
            if (idcomp === CatCompList.value) {
                var option = document.createElement("option")
                option.text = arrayText[index]
                option.value = arrayValues[index]
                option.style.color = color
                CatSubCompList.add(option)
            }
        })
        if (CatSubCompList.hasAttribute("hidden", "")) {
            CatSubCompList.removeAttribute("hidden")
            //lblSubComp.removeAttribute("hidden")
        }
        if (Id != 0) {
            CatSubCompList.value = Id
        }
        else {
            CatSubCompList.value = ""
        }
        }
</script>

<script type="text/javascript">
    $(document).ready(function () {
        $('.DatePicker').datepicker({
            format: "dd/mm/yyyy"
        });
        var objeto = $(".oculto")
        objeto.hide();

        var form = $("#FormCompetencias");
        $(form).removeData("validator");
        $.validator.unobtrusive.parse(form);


        $("#titulo option").each(function () {

            // alert("index->" + $(this).text().indexOf("Individuales |"));
            if ($(this).text().indexOf("Individuales |") >= 0) {
                $(this).css('color', '#F8CB53');
            }
            else if ($(this).text().indexOf("Gente |") >= 0) {
                $(this).css('color', '#5AA767');
            }
            else if ($(this).text().indexOf("Negocio |") >= 0) {
                $(this).css('color', '#00B2E9');
            }
        });
    });

</script>
<script>
    /* Evento para cuando el usuario libera la tecla escrita dentro del input */
    $('input,textarea').keyup(function () {
        /* Obtengo el valor contenido dentro del input */
        var value = $(this).val();

        /* Elimino todos los espacios en blanco que tenga la cadena delante y detrás */
        var value_without_space = value.trimStart();

        /* Muestro una alerta al usuario */
        //alert('El texto que ha ingresado contiene espacios y serán eliminados');

        /* Cambio el valor contenido por el valor sin espacios */
        $(this).val(value_without_space);
    });
</script>
